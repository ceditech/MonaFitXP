rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    // Check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user is the owner of the document (by uid path segment)
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Check if user has admin claim
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    // --- PROFILE FIELD VALIDATION ---

    // injuryFlags is health data (GDPR Art. 9 special category), so it is kept to
    // a closed vocabulary rather than accepting arbitrary client strings. Without
    // this the field is a free-text column the client fully controls — an easy
    // place for unbounded or unintended personal detail to accumulate.
    // Optional: profiles that never set it stay valid.
    function validInjuryFlags() {
      return !('injuryFlags' in request.resource.data)
        || (request.resource.data.injuryFlags is list
            && request.resource.data.injuryFlags.size() <= 20
            && request.resource.data.injuryFlags.hasOnly(
                 ['knees', 'lower_back', 'shoulders', 'wrists', 'neck']
               ));
    }

    // dateOfBirth drives the under-16 age gate, so a client must not be able to
    // edit it after the fact to slip past that check. Write-once: absent from the
    // stored doc, or unchanged. Enforced on update only — create is the one write
    // allowed to set it.
    function dateOfBirthUnchanged() {
      return !('dateOfBirth' in resource.data)
        || request.resource.data.get('dateOfBirth', null) == resource.data.dateOfBirth;
    }

    // --- GLOBAL CATALOGS ---

    // Exercise Catalog: Authenticated Read, Admin Write
    match /exerciseCatalog/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Plan Templates: Authenticated Read, Admin Write
    match /planTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- USER DATA ---

    // User Profile: Owner R/W, Delete Denied
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validInjuryFlags();
      allow update: if isOwner(uid) && validInjuryFlags() && dateOfBirthUnchanged();
      allow delete: if false; // Prevent accidental deletion
                              // NOTE: erasure (GDPR Art. 17) still has no
                              // server-side path either — see docs/ONBOARDING_SPEC.md G3.

      // Workouts: Owner R/W
      match /workouts/{workoutId} {
        allow read, write: if isOwner(uid);
        
        // Sets: Owner R/W
        match /sets/{setId} {
          allow read, write: if isOwner(uid);
        }
      }

      // Plans: Owner R/W
      match /plans/{planId} {
        allow read, write: if isOwner(uid);
      }

      // Custom Exercises: Owner R/W with basic shape validation
      match /customExercises/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.muscles is list;
      }

      // Stats & PRs: Owner R/W
      match /stats/{docId=**} {
        allow read, write: if isOwner(uid);
      }

      // Workout Logs: Owner R/W
      match /workoutLogs/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Metrics: Owner Read, Server-Only Write (No Client Write)
      match /metrics/{docId} {
        allow read: if isOwner(uid);
        allow write: if false; // Server-side function only
      }

      // Entitlements: Owner Read (get only), Server-Only Write
      match /entitlements/{docId} {
        allow get: if isOwner(uid);
        allow list: if false;
        allow write: if false; // Server-side function only
      }
    }

    // --- DEFAULT DENY (Safety Net) ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
