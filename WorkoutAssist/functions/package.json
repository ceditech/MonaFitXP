{
    "name": "functions",
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "jest",
        "test:rules": "firebase emulators:exec --only firestore --project demo-workoutassist --config ../firebase.json \"jest --config jest.rules.config.js\""
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "firebase-admin": "^13.0.1",
        "firebase-functions": "^6.0.1"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.1",
        "@types/jest": "^29.5.13",
        "firebase": "^12.16.0",
        "firebase-functions-test": "^3.1.0",
        "firebase-tools": "^15.24.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "typescript": "^4.9.0"
    },
    "private": true
}
