# WorkoutAssist — environment template.
# Copy this file to `.env` (which is gitignored) and fill in real values.
# NEVER put real secrets in this .example file.

# Black Forest Labs (FLUX) image generation — used by scripts/flux-generate.js
# Get a key at https://dashboard.bfl.ai/
BFL_API_KEY=

# Optional: override the FLUX model (default: flux-pro-1.1)
# BFL_MODEL=flux-pro-1.1

# Optional: per-image price used only for the cost estimate printout
# BFL_PRICE_PER_IMAGE=0.05
